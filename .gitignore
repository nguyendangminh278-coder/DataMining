# Dataset and generated output: do not accidentally publish
/data/raw/*
!/data/raw/.gitkeep
/input/*
!/input/.gitkeep
/output/*
!/output/.gitkeep
*.csv
*.csv.gz
*.parquet
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.feather
*.db
*.sqlite
*.log
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
*.key
*.pem
kaggle.json
.DS_Store
